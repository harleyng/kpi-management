    TENANT ||--o{ KPI_DEFINITION : "sở hữu thư viện"
    ORG_UNIT ||--o{ ORG_UNIT : "đơn vị con"
    ORG_UNIT ||--o{ EMPLOYEE_ASSIGNMENT : "chứa"
