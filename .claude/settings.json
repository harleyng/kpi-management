{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci *)",
      "Bash(npm install *)",
      "Bash(npm test *)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx playwright *)",
      "Bash(npx vercel *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git fetch *)",
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(gh repo *)",
      "Bash(gh auth *)",
      "Bash(gh run *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-workflow-context.sh\"",
            "statusMessage": "Injecting workflow context..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-kpi-safety.sh\"",
            "statusMessage": "Checking Syntra KPI safety..."
          }
        ]
      }
    ]
  }
}
