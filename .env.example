# Syntra KPI — environment variables.
# Copy this file to `.env.local` if you need to override a value (`.env*` is gitignored).
#
# VITE_* variables are inlined into the bundle at BUILD time, not at runtime —
# changing them requires a rebuild.

# Data adapter: `mock` (default — in-memory + localStorage, seeded fixtures) or `supabase`
# (not implemented until Phase 5 — it fails loudly, see src/integrations/data/supabaseGateway.ts).
VITE_DATA_ADAPTER=mock
